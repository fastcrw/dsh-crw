{
  "name": "dsh-crw",
  "version": "0.1.0",
  "description": "fastCRW-backed web search and fetch providers for DeepSeek Harness (ctx.web)",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "web-search",
    "web-fetch",
    "scraping",
    "fastcrw"
  ],
  "homepage": "https://github.com/us/dsh-crw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/us/dsh-crw.git"
  },
  "license": "MIT",
  "author": "Recep Ahmet Saritekin",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-web": ">=0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-web": "0.1.0-rc.6",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.20.0",
    "typescript": "^5.9.0"
  }
}
